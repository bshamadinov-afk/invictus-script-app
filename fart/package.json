{
  "name": "fart-card-game",
  "version": "0.1.0",
  "private": true,
  "description": "FART card game: deterministic rules engine (TypeScript)",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:web": "node scripts/build-web.mjs",
    "build": "npm run build:web && node scripts/build-server.mjs",
    "start": "node dist/server.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=20"
  }
}
